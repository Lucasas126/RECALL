# Copy to `.env` next to docker-compose.yml on the server. Placeholders only —
# never commit the filled-in file. Every line is passed to both RECALL
# containers (env_file) and read by docker compose for ${...} substitution.

# --- Web UI ---
# Session cookie signing secret (name set by web.session_secret_env).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RECALL_SESSION_SECRET=change-me

# --- Telegram (optional) ---
# The recall-telegram service only starts with this profile enabled. Leave it
# commented while the bot runs on another machine.
# COMPOSE_PROFILES=telegram
# Bot token from @BotFather. Only ONE process may poll a bot token: stop any
# local `run_telegram.py` using the same token, or give the server its own bot.
# TELEGRAM_BOT_TOKEN=123456:replace-me
# telegram_id=recall_user_id pairs, comma-separated (telegram.allowed_users_env).
# TELEGRAM_ALLOWED_USERS=123456789=your_user_id

# --- Model providers ---
# Shared OpenRouter key used by associative memory and chat naming.
OPENROUTER_API_KEY=sk-or-replace-me
# One line per user key referenced by `provider.api_key` in
# .config/<user_id>/user.yaml (the variable NAME is whatever that YAML says).
OPENROUTER_YOURUSER_API_KEY=sk-or-replace-me
# Optional: Tavily web search (tavily.api_key). Leave unset to disable.
# TAVILY_API_KEY=tvly-replace-me
# Optional: Ollama on the Docker host instead of localhost inside the container.
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Deploy (only read by docker-compose, not by the app) ---
# GitHub user/org that hosts the image at ghcr.io/<owner>/recall
# IMPORTANT: must be all lowercase — Docker rejects uppercase in image refs.
GHCR_OWNER=your-github-user
# Image tag to run. `latest` = newest published (non-pre) GitHub Release,
# auto-updated by Watchtower. Pin e.g. 0.2.0 to stop auto-updates.
RECALL_TAG=latest
# Host port for the web UI. Put Caddy/Traefik in front for HTTPS.
RECALL_PORT=8000
# Host folders mounted into the containers (must be writable by uid 1000).
RECALL_CONFIG_DIR=./config
RECALL_DATA_DIR=./data
RECALL_LOGS_DIR=./logs
# Container timezone (log timestamps).
TZ=Europe/Madrid
